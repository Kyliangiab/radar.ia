# ── IA : Groq (API OpenAI-compatible) ──
# Nécessaire pour le Briefing IA, les résumés et la classification.
# Récupère une clé gratuite sur https://console.groq.com/ → API Keys
GROQ_API_KEY=

# Modèles Groq (ADR-0002 — lus depuis l'env, jamais codés en dur).
# Vides = défauts du code. ENRICH = modèle "instant" volume (enrich, translate),
# SMART = modèle raisonnement bas volume (briefing, ask).
# Vérifier la disponibilité sur https://console.groq.com/docs/models.
# Défauts : GROQ_MODEL_ENRICH=openai/gpt-oss-20b · GROQ_MODEL_SMART=openai/gpt-oss-120b
GROQ_MODEL_ENRICH=
GROQ_MODEL_SMART=

# Régime de tokens à l'ingestion (ADR-0002 — vides = défauts du code).
# ENRICH_INPUT_MAX_CHARS : troncature du texte envoyé à l'enrichissement (défaut 800).
# MAX_ARTICLES_PER_SOURCE : plafond d'articles retenus par source et par run (défaut 15).
# ENRICH_CONCURRENCY      : appels Groq en parallèle (défaut 5 ; à réduire si 429).
# ENRICH_MAX_TOKENS       : budget de sortie de l'enrichissement (défaut 1000).
#   ⚠️ l'augmenter accroît la pression 429 (mesuré) ; ne monter que si le pipeline
#   remonte des parse_err/finish_reason="length" (ce n'était PAS le cas au 2026-07-14).
# MAX_RETRY_PER_RUN       : plafond du backlog de retry par run (défaut 30 ; ADR-0005).
#   La Phase A ne retente que les N plus anciens pending → drainage progressif,
#   sans saturer le rate limit d'un coup.
ENRICH_INPUT_MAX_CHARS=
MAX_ARTICLES_PER_SOURCE=
ENRICH_CONCURRENCY=
ENRICH_MAX_TOKENS=
MAX_RETRY_PER_RUN=

# ── Base de données : Supabase (serveur — routes API + ingestion) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase côté navigateur (auth Google + favoris) ──
# Settings → API. L'anon key est publique (protégée par RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Google OAuth (lu par la CLI Supabase : supabase start / config push) ──
# À créer dans Google Cloud Console → Credentials → OAuth client (Web).
# Redirect autorisé : https://<project-ref>.supabase.co/auth/v1/callback
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# ── Sources additionnelles (pipeline d'ingestion) ──
# Product Hunt (API GraphQL V2, token dev gratuit — https://www.producthunt.com/v2/oauth/applications)
PH_API_TOKEN=
# NewsAPI (OPTIONNEL — plan gratuit limité à localhost + 100 req/j, non commercial). Laisse vide pour ignorer.
NEWSAPI_KEY=

# — Embeddings de requête : Hugging Face Inference —
# Nécessaire pour la recherche sémantique (/api/search).
# Token gratuit, permission "Make calls to Inference Providers" uniquement.
HUGGINGFACE_API_KEY=
