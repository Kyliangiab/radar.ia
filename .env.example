# ── IA : Groq (API OpenAI-compatible) ──
# Nécessaire pour le Briefing IA, les résumés et la classification.
# Récupère une clé gratuite sur https://console.groq.com/ → API Keys
GROQ_API_KEY=

# ── Base de données : Supabase (serveur — routes API + ingestion) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase côté navigateur (auth Google + favoris) ──
# Settings → API. L'anon key est publique (protégée par RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Google OAuth (lu par la CLI Supabase : supabase start / config push) ──
# À créer dans Google Cloud Console → Credentials → OAuth client (Web).
# Redirect autorisé : https://<project-ref>.supabase.co/auth/v1/callback
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# ── Sources additionnelles (pipeline d'ingestion) ──
# Product Hunt (API GraphQL V2, token dev gratuit — https://www.producthunt.com/v2/oauth/applications)
PH_API_TOKEN=
# NewsAPI (OPTIONNEL — plan gratuit limité à localhost + 100 req/j, non commercial). Laisse vide pour ignorer.
NEWSAPI_KEY=
